# NMS environment configuration — copy to `.env` and fill in real values.
# These are the exact variables read by `pkg/config/config.go`
# (`LoadConfig`); defaults shown are the code defaults. Do NOT commit
# a filled-in `.env` with real secrets.

# --- Database (defaults shown) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=nmslite
DB_PASSWORD=changeme
DB_NAME=nmslite

# --- Connection pool ---
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFE_MINS=30

# --- Server ---
TLS_CERT_FILE=
TLS_KEY_FILE=
TRUSTED_PROXIES=

# --- General ---
PLUGINS_DIR=plugins

# --- Workers / scheduler ---
POLL_WORKER_COUNT=5
DISC_WORKER_COUNT=3
POLL_INTERVAL_SEC=30
AV_CHECK_TIMEOUT_MS=500
AV_CHECK_RETRIES=2
METRICS_WORKER_COUNT=4

# --- Metrics query defaults ---
METRICS_DEFAULT_LIMIT=100
METRICS_DEFAULT_LOOKBACK_HOURS=1

# --- Health monitor ---
FAILURE_WINDOW_MIN=3
FAILURE_THRESHOLD=3

# --- Security (MUST be changed from defaults for production) ---
JWT_SECRET=replace-me-with-random-64-hex-chars
ENCRYPTION_KEY=replace-me-with-a-random-64-char-key
NMS_ADMIN_USER=admin
# Bcrypt hash of the admin password; generate with e.g.:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'<password>', bcrypt.gensalt()).decode())"
NMS_ADMIN_HASH=replace-me-with-bcrypt-hash-of-admin-password

# --- Authentication ---
SESSION_DURATION_HOURS=168
